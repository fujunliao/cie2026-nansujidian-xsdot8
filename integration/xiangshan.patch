-  io.out.bits.res.data := vialu.io.out.bits.vd
+  // Reuse existing VIPU issue/VRF/ROB/writeback path and its 2-cycle reservation.
+  require(cfg.destDataBits == 128 && latency == 2)
+  private val dot = Module(new VDotPipe)
+  private val dotIn = fuOpType === XSDot8.fuOp
+  private val dotOut = outCtrl.fuOpType === XSDot8.fuOp
+  dot.io.clock := clock
+  dot.io.a := vs1
+  dot.io.b := vs2
+  dot.io.en1 := regEnable(1) && dotIn
+  dot.io.en2 := regEnable(2) && ctrlVec(1).fuOpType === XSDot8.fuOp
+  val xsdot8_issue = WireInit(io.in.valid && dotIn)
+  val xsdot8_writeback = WireInit(io.out.valid && dotOut)
+  dontTouch(xsdot8_issue)
+  dontTouch(xsdot8_writeback)
+  dontTouch(dot.io)
+  // Do not use the standard tail/mask merge for this custom full-register result.
+  io.out.bits.res.data := Mux(dotOut, dot.io.result, vialu.io.out.bits.vd)
+  when (dotOut) {
+    io.out.bits.ctrl.exceptionVec.get(ExceptionNO.illegalInstr) :=
+      outVecCtrl.vill || outVecCtrl.vsew =/= 0.U || outVecCtrl.vlmul =/= 0.U ||
+      !outVm || outVstart =/= 0.U || outVl =/= 8.U
